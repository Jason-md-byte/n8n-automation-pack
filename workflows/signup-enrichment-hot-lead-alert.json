    {
      "parameters": {
        "jsCode": "// Combine the original signup with enrichment data and compute a simple fit score.\n// Assumed enrichment response shape (adapt to your provider):\n//   { person: { title, linkedin_url }, company: { name, employees } }\nconst signup = $('Verify HMAC Signature').first().json.payload || {};\nconst res = $input.first().json || {};\nconst enriched = !res.error && (res.company || res.person);\nconst company = (res.company && res.company.name) || signup.company || '';\nconst employees = Number((res.company && res.company.employees) || 0);\nconst title = (res.person && res.person.title) || '';\nconst email = String(signup.email || '').trim().toLowerCase();\n\nconst freeMail = /@(gmail|yahoo|outlook|hotmail|icloud|proton)\\./i;\nlet score = 0;\nif (employees >= 200) score += 3;\nelse if (employees >= 50) score += 2;\nif (/(founder|owner|ceo|cto|coo|vp|head|director)/i.test(title)) score += 2;\nif (!freeMail.test(email)) score += 1;\n\nreturn [{\n  json: {\n    email,\n    firstName: String(signup.first_name || '').slice(0, 80),\n    lastName: String(signup.last_name || '').slice(0, 80),\n    company,\n    title,\n    employees,\n    linkedin: (res.person && res.person.linkedin_url) || '',\n    score,\n    hot: score >= 4,\n    enrichmentStatus: enriched ? 'ok' : 'failed_or_not_found',\n  },\n}];"
      },
