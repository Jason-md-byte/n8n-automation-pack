    {
      "parameters": {
        "jsCode": "// Verifies an HMAC-SHA256 signature over \"<X-Timestamp>.<raw body>\".\n// Required headers: X-Timestamp (unix seconds), X-Signature (\"sha256=<hex>\").\n// Required env var: WEBHOOK_SECRET (also set NODE_FUNCTION_ALLOW_BUILTIN=crypto).\nconst crypto = require('crypto');\nconst MAX_SKEW_SECONDS = 300;\nconst headers = $input.first().json.headers || {};\nconst fail = (reason) => [{ json: { valid: false, reason } }];\n\nconst secret = $env.WEBHOOK_SECRET;\nif (!secret) return fail('server_misconfigured'); // fail closed\n\nconst timestamp = headers['x-timestamp'];\nconst provided = String(headers['x-signature'] || '').replace(/^sha256=/, '');\nif (!timestamp || !provided) return fail('missing_signature_headers');\n\nconst skew = Math.abs(Date.now() / 1000 - Number(timestamp));\nif (!Number.isFinite(skew) || skew > MAX_SKEW_SECONDS) return fail('stale_timestamp');\n\nconst raw = await this.helpers.getBinaryDataBuffer(0, 'data');\nconst expected = crypto\n  .createHmac('sha256', secret)\n  .update(timestamp + '.')\n  .update(raw)\n  .digest('hex');\n\nconst a = Buffer.from(provided, 'hex');\nconst b = Buffer.from(expected, 'hex');\nif (a.length !== b.length || !crypto.timingSafeEqual(a, b)) return fail('bad_signature');\n\nlet payload;\ntry {\n  payload = JSON.parse(raw.toString('utf8'));\n} catch (e) {\n  return fail('invalid_json');\n}\nreturn [{ json: { valid: true, payload } }];"
      },
